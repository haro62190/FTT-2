# --- Discord ---
# Token du bot : https://discord.com/developers/applications > ton appli > Bot > Reset Token
DISCORD_TOKEN=
# ID de ton serveur : clic droit sur le serveur > Copier l'identifiant (mode développeur activé)
GUILD_ID=

# --- Twitch (alertes de live) ---
# Nom de ta chaîne Twitch (ex : ma_chaine)
TWITCH_CHANNEL=
# Identifiants d'une application Twitch : https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Fréquence de vérification du live, en secondes
TWITCH_POLL_SECONDS=60

# --- Musique (optionnel) ---
# Chemins de yt-dlp / ffmpeg s'ils ne sont pas dans le PATH
# YTDLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/bin/ffmpeg
# Fichier cookies.txt YouTube si YouTube bloque le VPS ("Sign in to confirm you're not a bot")
# YTDLP_COOKIES=/root/bot/cookies.txt
