# --- Discord ---
# Token du bot : https://discord.com/developers/applications > ton appli > Bot > Reset Token
DISCORD_TOKEN=
# ID de ton serveur : clic droit sur le serveur > Copier l'identifiant (mode développeur activé)
GUILD_ID=

# --- Twitch (alertes de live) ---
# Nom de ta chaîne Twitch (ex : ma_chaine)
TWITCH_CHANNEL=
# Identifiants d'une application Twitch : https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Fréquence de vérification du live, en secondes
TWITCH_POLL_SECONDS=60

# --- TikTok (alertes nouvelles vidéos + lives, optionnel) ---
# Ton pseudo TikTok, sans le @
TIKTOK_USERNAME=
# Fréquence de vérification, en secondes (120 conseillé, 60 minimum)
TIKTOK_POLL_SECONDS=120

# --- Musique (optionnel) ---
# Chemins de yt-dlp / ffmpeg s'ils ne sont pas dans le PATH
# YTDLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/bin/ffmpeg
# Fichier cookies.txt YouTube si YouTube bloque le VPS ("Sign in to confirm you're not a bot")
# YTDLP_COOKIES=/root/bot/cookies.txt

# --- Sécurité (optionnel) ---
# IDs de personnes / bots de confiance ignorés par l'anti-nuke, séparés par des virgules
SECURITY_WHITELIST=

# --- Tableau de bord web (optionnel) ---
# Portail développeur Discord > ton appli > OAuth2 > Client Secret (Reset Secret)
DISCORD_CLIENT_SECRET=
# Adresse du tableau de bord. Ajoute <DASHBOARD_URL>/callback dans OAuth2 > Redirects
DASHBOARD_URL=http://localhost:3000
DASHBOARD_PORT=3000
# 127.0.0.1 = accessible seulement depuis la machine du bot (via tunnel SSH, recommandé)
DASHBOARD_HOST=127.0.0.1

# Serveur de secours (identifiant d un serveur vide où le bot peut tout recopier en cas de piratage). Réglable aussi sur le site.
SECOURS_GUILD_ID=
